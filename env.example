# Copy to .env for local development. On Render, these are set as
# environment variables in render.yaml / the dashboard instead.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/energy_audit

# Generate a real random value for production, e.g.: openssl rand -hex 32
# The app falls back to an insecure development-only default if unset --
# never rely on that fallback outside local dev.
JWT_SECRET=change-me-to-a-random-64-char-hex-string

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_STANDARD_EUI_MJ_M2_YEAR=324
DEGREE_DAY_BASE_TEMP_C=18

# Recalibrate these to current local tariffs/emission factors before
# showing a client real Toman/CO2 figures -- see services/economics.py.
ELECTRICITY_TOMAN_PER_KWH=5000
GAS_TOMAN_PER_M3=3000
GRID_EMISSION_FACTOR_KG_CO2_PER_KWH=0.5
GAS_EMISSION_FACTOR_KG_CO2_PER_M3=2.0
